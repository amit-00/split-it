{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "split-it",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8787 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
