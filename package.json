{
  "name": "split-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^5.20260911.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  }
}
